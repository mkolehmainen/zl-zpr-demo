# dns-demo Corefile (syntax: zl-zpr-dev-context/docs/DNS.md, "Configuring it").
# Served by /app/bin/coredns inside the dns container; /conf is the mounted
# local-compute/conf/dns/ directory, assembled by deploy-docker.sh.
#
# The resolver answers <service>.demo from the VS admin API. The key string
# lives only in the mounted key file, never here. TTLs stay short on purpose:
# ZPR addresses are recycled across reconnects, and liveness (issue Step 3)
# expects NXDOMAIN within ttl + negative_ttl of a provider going away.
demo.:53 {
    zpr {
        endpoint       https://[fd5a:5052::1]:8182
        api_key_file   /conf/vs-resolve.key
        tls_ca         /conf/include/admin-tls-cert.pem
        tls_servername vs.zpr
        ttl            30
        negative_ttl   10
    }
    cache 30
    errors
    log
}
